{
	"name": "native-conversion-storybook",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "tools/storybook/native-conversion",
	"projectType": "application",
	"tags": ["scope:composition", "type:composition"],
	"implicitDependencies": ["editor", "editor-surface", "icons", "studio"],
	"targets": {
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/native-conversion"],
			"options": {
				"output-dir": "../../../storybook-static/native-conversion"
			},
			"inputs": [
				"default",
				"^default",
				"{workspaceRoot}/tools/ops/src/vite/excalidraw-fonts.ts",
				"{workspaceRoot}/tools/storybook/families/**/*"
			]
		},
		"chromatic": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-storybook"],
			"options": {
				"command": "chromatic --storybook-build-dir storybook-static/native-conversion --storybook-config-dir tools/storybook/native-conversion/.storybook --storybook-base-dir tools/storybook/native-conversion"
			}
		},
		"static-storybook": {
			"options": {
				"staticFilePath": "storybook-static/native-conversion"
			}
		},
		"storybook": {
			"options": {
				"port": 6010
			}
		}
	}
}
