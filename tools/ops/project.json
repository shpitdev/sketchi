{
	"name": "ops",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "tools/ops/src",
	"projectType": "application",
	"tags": ["scope:tool", "type:tool"],
	"targets": {
		"typecheck": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"default",
				"{workspaceRoot}/tools/build-config/{client-server-boundary,excalidraw-fonts,workers}.ts"
			],
			"outputs": [],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p tools/ops/tsconfig.app.json --noEmit"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"default",
				"testEnvironment",
				"{workspaceRoot}/tools/build-config/{client-server-boundary,excalidraw-fonts,workers}.ts",
				"{workspaceRoot}/.github/{actions,workflows}/**/*",
				"{workspaceRoot}/{apps,packages,tools}/**/package.json",
				"{workspaceRoot}/apps/{editor,icons,studio,web}/wrangler.jsonc",
				"{workspaceRoot}/apps/{editor,studio,web}/public/_headers",
				"{workspaceRoot}/packages/editor-surface/public/fonts/Excalifont/**/*",
				{
					"env": "PATH"
				},
				{
					"runtime": "mise --version"
				},
				{
					"runtime": "duckdb --version || true"
				}
			],
			"outputs": [],
			"options": {
				"command": "vitest run --config tools/ops/vitest.config.mts"
			}
		},
		"check-lint": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles"],
			"outputs": [],
			"options": {
				"command": "effect-tsgo oxlint"
			},
			"dependsOn": [
				{
					"projects": ["tag:scope:package"],
					"target": "build"
				}
			]
		},
		"check-format": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles"],
			"outputs": [],
			"options": {
				"command": "oxfmt --check"
			}
		},
		"check-tools": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"sharedGlobals",
				"testEnvironment",
				"{workspaceRoot}/tools/*.{ts,mts}",
				"{workspaceRoot}/tools/tsconfig.json",
				"{workspaceRoot}/tools/{build-config,oxlint,tests}/**/*",
				"{workspaceRoot}/tools/storybook/**/*.tsx",
				"{workspaceRoot}/apps/*/src/styles/app.css",
				"{workspaceRoot}/apps/*/public/fonts/Excalifont/**/*",
				{
					"input": "production",
					"projects": [
						"cloudflare",
						"community-icons",
						"diagram-scenarios",
						"diagrams",
						"drawing",
						"editor-surface",
						"icon-catalog",
						"icon-draw",
						"observability",
						"studio",
						"ui"
					]
				}
			],
			"outputs": [],
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p tools/tsconfig.json --noEmit",
					"vitest run --config tools/vitest.config.mts"
				],
				"parallel": false
			},
			"dependsOn": [
				{
					"projects": ["tag:scope:package"],
					"target": "build"
				}
			]
		},
		"check-references": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles", "!{workspaceRoot}/.oxlintrc.json"],
			"outputs": [],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -b --pretty false"
			},
			"dependsOn": [
				{
					"projects": ["*"],
					"target": "build"
				}
			]
		},
		"check-workflows": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{workspaceRoot}/.github/**/*",
				{
					"runtime": "actionlint --version"
				},
				{
					"env": "PATH"
				}
			],
			"outputs": [],
			"options": {
				"command": "actionlint"
			}
		}
	}
}
