{
	"name": "ops",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "tools/ops/src",
	"projectType": "application",
	"tags": ["scope:tool", "type:tool"],
	"targets": {
		"typecheck": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["default"],
			"outputs": [],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p tools/ops/tsconfig.app.json --noEmit"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"workspaceFiles",
				"testEnvironment",
				{
					"env": "PATH"
				},
				{
					"runtime": "mise --version"
				},
				{
					"runtime": "duckdb --version || true"
				}
			],
			"outputs": [],
			"options": {
				"command": "vitest run --config tools/ops/vitest.config.mts"
			}
		},
		"check-lint": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles"],
			"outputs": [],
			"options": {
				"command": "effect-tsgo oxlint"
			},
			"dependsOn": [
				{
					"projects": ["tag:scope:package"],
					"target": "build"
				}
			]
		},
		"check-format": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles"],
			"outputs": [],
			"options": {
				"command": "oxfmt --check"
			}
		},
		"check-tools": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles", "testEnvironment"],
			"outputs": [],
			"options": {
				"command": "pnpm run test:tools"
			},
			"dependsOn": [
				{
					"projects": ["tag:scope:package"],
					"target": "build"
				}
			]
		},
		"check-references": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["workspaceFiles"],
			"outputs": [],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -b --pretty false"
			},
			"dependsOn": [
				{
					"projects": ["*"],
					"target": "build"
				}
			]
		},
		"check-workflows": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{workspaceRoot}/.github/**/*",
				{
					"runtime": "actionlint --version"
				},
				{
					"env": "PATH"
				}
			],
			"outputs": [],
			"options": {
				"command": "actionlint"
			}
		}
	}
}
