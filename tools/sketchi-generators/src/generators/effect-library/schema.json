{
	"$schema": "https://json-schema.org/schema",
	"$id": "SketchiEffectLibrary",
	"title": "Effect library",
	"type": "object",
	"properties": {
		"directory": { "type": "string", "$default": { "$source": "argv", "index": 0 } },
		"name": { "type": "string" },
		"importPath": { "type": "string", "description": "Explicit ESM package import identity." },
		"tags": { "type": "string", "description": "Comma-separated Nx scope and type tags." },
		"skipFormat": { "type": "boolean", "default": false }
	},
	"required": ["directory", "name", "importPath", "tags"]
}
