import { describe, expect, it } from "vitest";

import { <%= fixtureName %>, getCanvasValidationIssues } from "@sketchi/diagram-core";

import { renderDiagram } from "../diagram.js";

describe("<%= className %> renderer contract", () => {
  it("renders the generated fixture into a valid deterministic scene", () => {
    const scene = renderDiagram(<%= fixtureName %>);

    expect(scene.diagramId).toBe("<%= typeValue %>-example");
    expect(getCanvasValidationIssues(scene)).toEqual([]);
    expect(renderDiagram(<%= fixtureName %>)).toEqual(scene);
  });
});
