import { Result, Schema } from "effect";

import { type DiagramValidationError, IntermediateDiagram, validateIntermediateDiagram } from "../intermediate.js";

export const <%= propertyName %>DiagramType = "<%= typeValue %>" as const;

/**
 * The canonical <%= typeValue %> contract, scaffolded as a node/edge graph.
 * Replace it with the family's own shape (see sequence.ts) when nodes and
 * edges do not describe it, and follow docs/diagram-families.md.
 */
export const <%= className %>Diagram = Schema.Struct({
  ...IntermediateDiagram.fields,
  type: Schema.Literal(<%= propertyName %>DiagramType),
}).annotate({ identifier: "<%= className %>Diagram" });

export interface <%= className %>Diagram extends Schema.Schema.Type<typeof <%= className %>Diagram> {}

export function validate<%= className %>Diagram(diagram: <%= className %>Diagram): Result.Result<<%= className %>Diagram, DiagramValidationError> {
  return Result.map(validateIntermediateDiagram(diagram), () => diagram);
}

export function parse<%= className %>Diagram(input: unknown): Result.Result<<%= className %>Diagram, Schema.SchemaError | DiagramValidationError> {
  return Result.flatMap(Schema.decodeUnknownResult(<%= className %>Diagram, { errors: "all" })(input), validate<%= className %>Diagram);
}

// Maintained fixture data is trusted; invalid construction is a fixture defect.
export const <%= fixtureName %> = parse<%= className %>Diagram({
  id: "<%= typeValue %>-example",
  title: <%- titleLiteral %>,
  type: <%= propertyName %>DiagramType,
  nodes: [
    { id: "root", label: "<%= className %>" },
    { id: "first-branch", label: "First branch" },
    { id: "second-branch", label: "Second branch" }
  ],
  edges: [
    {
      id: "root-first-branch",
      source: "root",
      target: "first-branch",
      label: "expands"
    },
    {
      id: "root-second-branch",
      source: "root",
      target: "second-branch",
      label: "connects"
    }
  ],
  layout: {
    direction: "LR",
    edgeRouting: "orthogonal"
  }
}).pipe(Result.getOrThrow);
