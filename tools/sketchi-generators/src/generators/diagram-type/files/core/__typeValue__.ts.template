import { Schema } from "effect";

import { IntermediateDiagram, validateIntermediateDiagram } from "../intermediate.js";

export const <%= propertyName %>DiagramType = "<%= typeValue %>" as const;

/**
 * The canonical <%= typeValue %> contract, scaffolded as a node/edge graph.
 * Replace it with the family's own shape (see sequence.ts) when nodes and
 * edges do not describe it, and follow docs/diagram-families.md.
 */
export class <%= className %>Diagram extends IntermediateDiagram.extend<<%= className %>Diagram>(
  "<%= className %>Diagram",
)({
  type: Schema.Literal(<%= propertyName %>DiagramType),
}) {}
export const <%= className %>DiagramSchema = <%= className %>Diagram;

export function validate<%= className %>Diagram(diagram: <%= className %>Diagram): <%= className %>Diagram {
  validateIntermediateDiagram(diagram);
  return diagram;
}

export function parse<%= className %>Diagram(input: unknown): <%= className %>Diagram {
  return validate<%= className %>Diagram(
    Schema.decodeUnknownSync(<%= className %>Diagram, { errors: "all" })(input),
  );
}

export const <%= fixtureName %> = parse<%= className %>Diagram({
  id: "<%= typeValue %>-example",
  title: <%- titleLiteral %>,
  type: <%= propertyName %>DiagramType,
  nodes: [
    { id: "root", label: "<%= className %>" },
    { id: "first-branch", label: "First branch" },
    { id: "second-branch", label: "Second branch" }
  ],
  edges: [
    {
      id: "root-first-branch",
      source: "root",
      target: "first-branch",
      label: "expands"
    },
    {
      id: "root-second-branch",
      source: "root",
      target: "second-branch",
      label: "connects"
    }
  ],
  layout: {
    direction: "LR",
    edgeRouting: "orthogonal"
  }
});
