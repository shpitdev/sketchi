import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { <%= className %> } from "./<%= fileName %>";

describe("<%= className %>", () => {
  it("renders an accessible component shell", () => {
    render(
      <<%= className %>
        description="Generated by the Sketchi UI component generator."
        title="Generated component"
      />
    );

    expect(
      screen.getByRole("region", { name: "Generated component" })
    ).toBeTruthy();
    expect(
      screen.getByRole("heading", { name: "Generated component" })
    ).toBeTruthy();
    expect(
      screen.getByText("Generated by the Sketchi UI component generator.")
    ).toBeTruthy();
  });
});
