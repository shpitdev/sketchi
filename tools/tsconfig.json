{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@sketchi/drawing/excalidraw": ["../packages/drawing/src/excalidraw/index.ts"],
      "@sketchi/diagram-scenarios": ["./scenarios/src/index.ts"],
      "@sketchi/icon-catalog": ["../packages/icons/catalog/src/index.ts"],
      "@sketchi/observability": ["../packages/observability/src/index.ts"],
      "@sketchi/drawing/artifacts": ["../packages/drawing/src/artifacts.ts"],
      "@sketchi/drawing": ["../packages/drawing/src/index.ts"],
      "@sketchi/editor-surface": ["../packages/editor-surface/dist/index.d.ts"],
      "@sketchi/cloudflare/*": ["../packages/cloudflare/src/*"],
      "@sketchi/diagrams/*": ["../packages/diagrams/src/*"]
    },
    "composite": false
  },
  "include": [
    "*.ts",
    "*.mts",
    "build-config/**/*.ts",
    "tests/**/*.ts",
    "oxlint/**/*.ts",
    "storybook/**/*.tsx"
  ]
}
