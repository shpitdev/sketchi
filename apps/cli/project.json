{
	"name": "sketchi-cli",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/cli/src",
	"projectType": "application",
	"tags": ["scope:app", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"inputs": ["runtime", "^production"],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "node apps/cli/scripts/build.mjs"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "vitest run --config apps/cli/vitest.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p apps/cli/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p apps/cli/tsconfig.app.json --noEmit"
				],
				"parallel": false
			}
		},
		"package": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"outputs": ["{workspaceRoot}/.memory/cli-package"],
			"options": {
				"command": "node apps/cli/scripts/package.mjs"
			}
		},
		"smoke": {
			"executor": "nx:run-commands",
			"dependsOn": ["package", "bundle-report"],
			"outputs": ["{workspaceRoot}/.memory/cli-smoke"],
			"options": {
				"command": "node apps/cli/scripts/smoke.mjs"
			}
		},
		"bundle-report": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"outputs": ["{workspaceRoot}/.memory/cli-bundle-report.json"],
			"options": {
				"command": "node apps/cli/scripts/bundle-report.mjs"
			}
		}
	}
}
