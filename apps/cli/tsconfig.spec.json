{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"],
    "noEmit": true,
    "composite": false,
    "rootDir": "../..",
    "tsBuildInfoFile": "dist/tsconfig.spec.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "vitest.config.mts", "src/**/*.test.ts", "src/**/*.d.ts"]
}
