{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../packages/diagram/agent/tsconfig.lib.json" },
    { "path": "../../packages/diagram/core/tsconfig.lib.json" },
    { "path": "../../packages/diagram/generation/tsconfig.lib.json" }
  ]
}
