{
  "name": "eval-harness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/eval-harness/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "type:eval"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/eval-harness",
        "{projectRoot}/.wrangler/deploy/config.json"
      ],
      "options": {
        "command": "vite build --config apps/eval-harness/vite.config.ts"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PORTLESS_PORT=443 portless run --name eval-harness.sketchi vite dev --config apps/eval-harness/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/eval-harness/vite.config.ts --host 127.0.0.1 --port 6300"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "wrangler deploy --config dist/apps/eval-harness/server/wrangler.json"
      }
    },
    "cf-typegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler types --config apps/eval-harness/wrangler.jsonc"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/eval-harness"],
      "options": {
        "command": "vitest run --config apps/eval-harness/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/eval-harness/tsconfig.json --noEmit"
      }
    },
    "typecheck-tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo -p apps/eval-harness/tsconfig.json --noEmit"
      }
    }
  }
}
