{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sketchi-playground",
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	// sketchi_telemetry_spans_production. Not remote, so local development stays out of it.
	"pipelines": [
		{
			"binding": "TELEMETRY_SPANS",
			"stream": "e118fdd69a2548258389e82fb1ade1d6"
		}
	],
	"workers_dev": true,
	"vars": {
		"SKETCHI_APP_SURFACE": "playground",
		"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
		"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite"
	},
	"previews": {
		"vars": {
			"SKETCHI_APP_SURFACE": "playground",
			"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
			"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite"
		},
		"ai": {
			"binding": "AI",
			"remote": true
		},
		"observability": {
			"enabled": true,
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1
			}
		},
		// sketchi_telemetry_spans_preview
		"pipelines": [
			{
				"binding": "TELEMETRY_SPANS",
				"stream": "d3066c58106b4facbc146e9188e383b1"
			}
		]
	}
}
