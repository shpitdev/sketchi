{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sketchi-studio",
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker-entry.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	// Holds warm Browser Run pages for Code Mode PNG export between requests.
	"durable_objects": {
		"bindings": [
			{
				"name": "CODEMODE_PNG_RENDERER",
				"class_name": "CodeModePngRenderer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CodeModePngRenderer"]
		}
	],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "SKETCHI_ARTIFACTS",
			"bucket_name": "sketchi-studio-codemode-artifacts-production",
			"preview_bucket_name": "sketchi-studio-codemode-artifacts-preview"
		}
	],
	"pipelines": [
		{
			"binding": "CODEMODE_USAGE_EVENTS",
			"stream": "d9044253316f4273a60298098f444a62",
			"remote": true
		},
		{
			"binding": "CODEMODE_USAGE_ISSUES",
			"stream": "f687dab6e7d742c1a76834089e709462",
			"remote": true
		}
	],
	"workers_dev": true,
	"vars": {
		"SKETCHI_APP_SURFACE": "studio",
		"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
		"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite"
	},
	"previews": {
		// PROBE ONLY (do not merge): run near the WNAM artifact bucket.
		"placement": { "region": "aws:us-west-2" },
		"vars": {
			"SKETCHI_APP_SURFACE": "studio",
			"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
			"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite"
		},
		"ai": {
			"binding": "AI",
			"remote": true
		},
		"browser": {
			"binding": "BROWSER",
			"remote": true
		},
		"worker_loaders": [
			{
				"binding": "LOADER"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "CODEMODE_PNG_RENDERER",
					"class_name": "CodeModePngRenderer"
				}
			]
		},
		"observability": {
			"enabled": true
		},
		"r2_buckets": [
			{
				"binding": "SKETCHI_ARTIFACTS",
				"bucket_name": "sketchi-studio-codemode-artifacts-preview"
			}
		],
		"pipelines": [
			{
				"binding": "CODEMODE_USAGE_EVENTS",
				"stream": "e9fc3bcd35314fa39fc6a89018207acc",
				"remote": true
			},
			{
				"binding": "CODEMODE_USAGE_ISSUES",
				"stream": "d95a1767edf246af8c637c5b9bf5a5c5",
				"remote": true
			}
		]
	}
}
