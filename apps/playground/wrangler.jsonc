{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sketchi-studio",
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker-entry.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	// Holds warm Browser Run pages for Code Mode PNG export between requests.
	"durable_objects": {
		"bindings": [
			{
				"name": "CODEMODE_PNG_RENDERER",
				"class_name": "CodeModePngRenderer"
			},
			// Counts icon draws per UTC day, against SKETCHI_ICON_DAILY_DRAWS.
			{
				"name": "ICON_DRAW_BUDGET",
				"class_name": "IconDrawBudget"
			},
			// One per client IP: its icon draw requests in the last minute, an exact limit.
			{
				"name": "ICON_DRAW_CLIENT_LIMIT",
				"class_name": "ClientRateLimit"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CodeModePngRenderer"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["IconDrawBudget"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["ClientRateLimit"]
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"r2_buckets": [
		{
			"binding": "SKETCHI_ARTIFACTS",
			"bucket_name": "sketchi-studio-codemode-artifacts-production",
			"preview_bucket_name": "sketchi-studio-codemode-artifacts-preview"
		}
	],
	// Community icons the icons app publishes; Studio only reads them.
	"d1_databases": [
		{
			"binding": "COMMUNITY_ICONS",
			"database_name": "sketchi-community-icons",
			"database_id": "2f12d256-d5c2-471c-97c7-bcefad4a558c",
			"preview_database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
		}
	],
	"pipelines": [
		// sketchi_telemetry_spans_production. Not remote, so local development stays out of it.
		{
			"binding": "TELEMETRY_SPANS",
			"stream": "e118fdd69a2548258389e82fb1ade1d6"
		}
	],
	"workers_dev": true,
	"vars": {
		"SKETCHI_APP_SURFACE": "studio",
		"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
		"SKETCHI_AI_GENERATE_MODEL": "anthropic/claude-haiku-5-5",
		"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite",
		// Icon draws a day across every client: about $0.015 each, $0.06 at most.
		"SKETCHI_ICON_DAILY_DRAWS": "300"
	},
	"previews": {
		"vars": {
			"SKETCHI_APP_SURFACE": "studio",
			"SKETCHI_AI_GATEWAY_ID": "google-ai-studio",
			"SKETCHI_AI_GENERATE_MODEL": "anthropic/claude-haiku-5-5",
			"SKETCHI_AI_MODEL": "google/gemini-3.1-flash-lite",
			"SKETCHI_ICON_DAILY_DRAWS": "100"
		},
		"ai": {
			"binding": "AI",
			"remote": true
		},
		"browser": {
			"binding": "BROWSER",
			"remote": true
		},
		"worker_loaders": [
			{
				"binding": "LOADER"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "CODEMODE_PNG_RENDERER",
					"class_name": "CodeModePngRenderer"
				},
				{
					"name": "ICON_DRAW_BUDGET",
					"class_name": "IconDrawBudget"
				},
				{
					"name": "ICON_DRAW_CLIENT_LIMIT",
					"class_name": "ClientRateLimit"
				}
			]
		},
		"observability": {
			"enabled": true,
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1
			}
		},
		"r2_buckets": [
			{
				"binding": "SKETCHI_ARTIFACTS",
				"bucket_name": "sketchi-studio-codemode-artifacts-preview"
			}
		],
		"d1_databases": [
			{
				"binding": "COMMUNITY_ICONS",
				"database_name": "sketchi-community-icons-preview",
				"database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
			}
		],
		"pipelines": [
			// sketchi_telemetry_spans_preview
			{
				"binding": "TELEMETRY_SPANS",
				"stream": "d3066c58106b4facbc146e9188e383b1"
			}
		]
	}
}
