{
	"name": "icons",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/icons/src",
	"projectType": "application",
	"tags": ["scope:app", "type:app"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"inputs": [
				"production",
				"^production",
				"{workspaceRoot}/tools/ops/src/workers.ts",
				"{workspaceRoot}/tools/local-dev-ports.ts"
			],
			"dependsOn": ["sync-catalog-assets"],
			"outputs": ["{workspaceRoot}/dist/apps/icons", "{projectRoot}/.wrangler/deploy/config.json"],
			"options": {
				"command": "vite build --config apps/icons/vite.config.ts"
			}
		},
		"cf-typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wrangler types --config apps/icons/wrangler.jsonc"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "wrangler deploy --config dist/apps/icons/server/wrangler.json"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"dependsOn": ["sync-catalog-assets"],
			"options": {
				"command": "vite dev --config apps/icons/vite.config.ts"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview --config apps/icons/vite.config.ts --host 127.0.0.1 --port 6303"
			}
		},
		"sync-catalog-assets": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"],
			"outputs": [
				"{projectRoot}/public/icons-manifest.json",
				"{projectRoot}/public/icon-drawings.json",
				"{projectRoot}/public/sketchi-icons.excalidrawlib",
				"{projectRoot}/public/sketchi-icons-with-names.excalidrawlib",
				"{projectRoot}/public/packs",
				"{projectRoot}/public/output",
				"{projectRoot}/public/card.png"
			],
			"options": {
				"command": "jiti apps/icons/scripts/sync-catalog-assets.ts"
			},
			"cache": true
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "vitest run --config apps/icons/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["effect-tsgo tsc@7.0.2 -p apps/icons/tsconfig.app.json --noEmit"],
				"parallel": false
			}
		}
	}
}
