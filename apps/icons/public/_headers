# Public SVG and agent API contracts.
/output/upload-ready/svg/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Max-Age: 86400
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Access-Control-Max-Age: 86400
  Cross-Origin-Resource-Policy: cross-origin

/mcp
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: DELETE, GET, OPTIONS, POST
  Access-Control-Allow-Headers: Content-Type, MCP-Protocol-Version, MCP-Session-Id
  Access-Control-Expose-Headers: MCP-Session-Id
  Access-Control-Max-Age: 86400

/icons-manifest.json
  Cache-Control: public, max-age=3600

/icon-drawings.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/sketchi-icons.excalidrawlib
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  Content-Type: application/json
  Content-Disposition: attachment; filename="sketchi-icons.excalidrawlib"

# Packs: libraries to download, their previews, and their index.
/packs/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/packs/*.excalidrawlib
  Content-Type: application/json
  Content-Disposition: attachment; filename="sketchi-:splat.excalidrawlib"
