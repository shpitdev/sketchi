{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sketchi-icons",
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker-entry.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Jev moderates community icon names on Workers AI.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "COMMUNITY_ICONS",
			"database_name": "sketchi-community-icons",
			"database_id": "2f12d256-d5c2-471c-97c7-bcefad4a558c",
			"preview_database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
		}
	],
	// Publishing is public: one object per client IP counts its publishes, an exact limit.
	"durable_objects": {
		"bindings": [
			{
				"name": "COMMUNITY_CLIENT_LIMIT",
				"class_name": "ClientRateLimit"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ClientRateLimit"]
		}
	],
	"workers_dev": true,
	"vars": {
		"SKETCHI_APP_SURFACE": "icons",
		// Visitors can publish a category pack to Excalidraw's library collection.
		// Previews leave it unset, so a preview never opens a real submission.
		"EXCALIDRAW_LIBRARY_SUBMIT": "on"
	},
	"previews": {
		"vars": {
			"SKETCHI_APP_SURFACE": "icons"
		},
		"observability": {
			"enabled": true
		},
		"ai": {
			"binding": "AI",
			"remote": true
		},
		"d1_databases": [
			{
				"binding": "COMMUNITY_ICONS",
				"database_name": "sketchi-community-icons-preview",
				"database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "COMMUNITY_CLIENT_LIMIT",
					"class_name": "ClientRateLimit"
				}
			]
		}
	}
}
