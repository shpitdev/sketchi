{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "sketchi-icons",
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Jev moderates community icon names on Workers AI.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "COMMUNITY_ICONS",
			"database_name": "sketchi-community-icons",
			"database_id": "2f12d256-d5c2-471c-97c7-bcefad4a558c",
			"preview_database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
		}
	],
	// Publishing is public: each client IP may publish this many icons a minute.
	"ratelimits": [
		{
			"name": "COMMUNITY_PUBLISH_LIMIT",
			"namespace_id": "6201",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"workers_dev": true,
	"vars": {
		"SKETCHI_APP_SURFACE": "icons"
	},
	"previews": {
		"vars": {
			"SKETCHI_APP_SURFACE": "icons"
		},
		"observability": {
			"enabled": true
		},
		"ai": {
			"binding": "AI",
			"remote": true
		},
		"d1_databases": [
			{
				"binding": "COMMUNITY_ICONS",
				"database_name": "sketchi-community-icons-preview",
				"database_id": "21be8746-89ec-4af2-9981-e21808adedb3"
			}
		],
		"ratelimits": [
			{
				"name": "COMMUNITY_PUBLISH_LIMIT",
				"namespace_id": "6202",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	}
}
