# Excalidraw fonts, generated by excalidrawFontHeaders() in
# scripts/lib/excalidraw-fonts.mjs. Keep this block in sync.
/fonts/Assistant/*
  Cache-Control: public, max-age=86400
/fonts/Cascadia/*
  Cache-Control: public, max-age=86400
/fonts/ComicShanns/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/Excalifont/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/Liberation/*
  Cache-Control: public, max-age=86400
/fonts/Lilita/*
  Cache-Control: public, max-age=86400
/fonts/Nunito/*
  Cache-Control: public, max-age=86400
/fonts/Virgil/*
  Cache-Control: public, max-age=86400
/fonts/Xiaolai/*
  Cache-Control: public, max-age=31536000, immutable
