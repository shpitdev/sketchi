{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/web/src",
	"projectType": "application",
	"tags": ["scope:app", "type:app"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/apps/web", "{projectRoot}/.wrangler/deploy/config.json"],
			"options": {
				"command": "vite build --config apps/web/vite.config.ts"
			}
		},
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/web"],
			"options": {
				"output-dir": "../../storybook-static/web"
			}
		},
		"cf-typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wrangler types --config apps/web/wrangler.jsonc"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "wrangler deploy --config dist/apps/web/server/wrangler.json"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "PORTLESS_PORT=443 portless run --name sketchi vite dev --config apps/web/vite.config.ts"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1 --port 6301"
			}
		},
		"storybook": {
			"options": {
				"port": 6007
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/apps/web"],
			"options": {
				"command": "vitest run --config apps/web/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p apps/web/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p apps/web/tsconfig.json --noEmit"
			}
		}
	}
}
