{
	"name": "web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/web/src",
	"projectType": "application",
	"tags": ["scope:app", "type:app"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"inputs": [
				"production",
				"^production",
				"{workspaceRoot}/tools/build-config/excalidraw-fonts.ts",
				"{workspaceRoot}/tools/build-config/workers.ts",
				"{workspaceRoot}/tools/build-config/local-dev-ports.ts"
			],
			"outputs": ["{workspaceRoot}/dist/apps/web", "{projectRoot}/.wrangler/deploy/config.json"],
			"options": {
				"command": "vite build --config apps/web/vite.config.ts"
			}
		},
		"cf-typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wrangler types --config apps/web/wrangler.jsonc"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "wrangler deploy --config dist/apps/web/server/wrangler.json"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite dev --config apps/web/vite.config.ts"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1 --port 6301"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --config apps/web/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["effect-tsgo tsc@7.0.2 -p apps/web/tsconfig.app.json --noEmit"],
				"parallel": false
			}
		},
		"social-card": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"options": {
				"command": "jiti apps/web/scripts/social-card.ts"
			}
		},
		"home-diagram": {
			"executor": "nx:run-commands",
			"options": {
				"command": "jiti apps/web/scripts/home-diagram.ts"
			}
		}
	}
}
