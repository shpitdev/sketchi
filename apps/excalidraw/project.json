{
	"name": "excalidraw",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/excalidraw/src",
	"projectType": "application",
	"tags": ["scope:app", "type:app"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": [
				"{workspaceRoot}/dist/apps/excalidraw",
				"{projectRoot}/.wrangler/deploy/config.json"
			],
			"options": {
				"command": "vite build --config apps/excalidraw/vite.config.ts"
			}
		},
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/excalidraw"],
			"options": {
				"output-dir": "../../storybook-static/excalidraw"
			}
		},
		"cf-typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wrangler types --config apps/excalidraw/wrangler.jsonc"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "wrangler deploy --config dist/apps/excalidraw/server/wrangler.json"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "PORTLESS_PORT=443 portless run --name excalidraw.sketchi vite dev --config apps/excalidraw/vite.config.ts"
			}
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview --config apps/excalidraw/vite.config.ts --host 127.0.0.1 --port 6302"
			}
		},
		"storybook": {
			"options": {
				"port": 6008
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/apps/excalidraw"],
			"options": {
				"command": "vitest run --config apps/excalidraw/vitest.config.ts"
			}
		},
		"test-browser": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --config apps/excalidraw/vitest.browser.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p apps/excalidraw/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p apps/excalidraw/tsconfig.json --noEmit"
			}
		}
	}
}
