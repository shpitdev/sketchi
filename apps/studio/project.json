{
	"name": "studio",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/studio/src",
	"projectType": "application",
	"tags": ["scope:app", "type:app"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"inputs": [
				"production",
				"^production",
				"{workspaceRoot}/tools/ops/src/vite/excalidraw-fonts.ts",
				"{workspaceRoot}/tools/ops/src/vite/client-server-boundary.ts",
				"{workspaceRoot}/tools/ops/src/workers.ts",
				"{workspaceRoot}/tools/local-dev-ports.ts"
			],
			"outputs": ["{workspaceRoot}/dist/apps/studio", "{projectRoot}/.wrangler/deploy/config.json"],
			"options": {
				"command": "vite build --config apps/studio/vite.config.ts"
			},
			"dependsOn": ["^build", "sync-node-logos"]
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite dev --config apps/studio/vite.config.ts"
			},
			"dependsOn": ["sync-node-logos"]
		},
		"preview": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite preview --config apps/studio/vite.config.ts --host 127.0.0.1 --port 6310"
			}
		},
		"deploy": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "wrangler deploy --config dist/apps/studio/server/wrangler.json"
			}
		},
		"cf-typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wrangler types --config apps/studio/wrangler.jsonc"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --config apps/studio/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["effect-tsgo tsc@7.0.2 -p apps/studio/tsconfig.app.json --noEmit"],
				"parallel": false
			}
		},
		"sync-node-logos": {
			"executor": "nx:run-commands",
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"],
			"outputs": ["{projectRoot}/public/node-logos"],
			"options": {
				"command": "jiti apps/studio/scripts/sync-node-logos.ts"
			},
			"cache": true
		}
	}
}
