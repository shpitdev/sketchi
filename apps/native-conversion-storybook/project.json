{
	"name": "native-conversion-storybook",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/native-conversion-storybook",
	"projectType": "application",
	"tags": ["scope:composition", "type:composition"],
	"implicitDependencies": ["diagram-ui", "excalidraw", "icons"],
	"targets": {
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/native-conversion"],
			"options": {
				"output-dir": "../../storybook-static/native-conversion"
			}
		},
		"chromatic": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-storybook"],
			"options": {
				"command": "chromatic --storybook-build-dir storybook-static/native-conversion --storybook-config-dir apps/native-conversion-storybook/.storybook --storybook-base-dir apps/native-conversion-storybook"
			}
		},
		"static-storybook": {
			"options": {
				"staticFilePath": "storybook-static/native-conversion"
			}
		},
		"storybook": {
			"options": {
				"port": 6010
			}
		}
	}
}
