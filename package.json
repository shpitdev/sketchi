{
	"name": "sketchi",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"affected": "nx affected",
		"build": "nx run-many -t build",
		"build-storybook": "nx run native-conversion-storybook:build-storybook",
		"cf-typegen:all": "nx run-many -t cf-typegen",
		"deploy:editor": "nx deploy editor",
		"deploy:icons": "nx deploy icons",
		"deploy:studio": "nx deploy studio",
		"deploy:web": "nx deploy web",
		"dev": "nx run-many -t dev --parallel=5",
		"dev:editor": "pnpm nx dev editor",
		"dev:icons": "pnpm nx dev icons",
		"dev:studio": "pnpm nx dev studio",
		"dev:web": "pnpm nx dev web",
		"ci:local": "node tools/ops/ci-local.mjs",
		"ops": "jiti tools/ops/src/main.ts",
		"check": "pnpm run lint && pnpm run format:check && pnpm run test:lint-rules",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "nx run-many -t build --projects=tag:scope:package --outputStyle=static-failures-only && effect-tsgo oxlint",
		"preview": "nx run-many -t preview --parallel",
		"db": "jiti tools/ops/src/main.ts db --",
		"sanity": "jiti tools/ops/src/main.ts sanity",
		"telemetry:resources": "jiti tools/ops/src/main.ts telemetry resources",
		"telemetry:provision": "jiti tools/ops/src/main.ts telemetry provision",
		"test:lint-rules": "vitest run --config tools/vitest.config.mts tools/oxlint",
		"test:tools": "effect-tsgo tsc@7.0.2 -p tools/tsconfig.json --noEmit && vitest run --config tools/vitest.config.mts",
		"storybook": "nx run native-conversion-storybook:storybook",
		"test": "nx run-many -t test,verify-tests",
		"test:wrangler-dry-runs": "jiti tools/ops/src/main.ts dry-run",
		"toolchain:verify": "node tools/ops/verify-toolchain.mjs",
		"typecheck": "nx run-many -t typecheck"
	},
	"dependencies": {
		"@cloudflare/codemode": "0.5.6",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"effect": "catalog:",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@babel/core": "8.0.10",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@cloudflare/vite-plugin": "1.66.0",
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "0.69.0",
		"@effect/vitest": "catalog:",
		"@nx/eslint-plugin": "24.0.3",
		"@nx/js": "24.0.3",
		"@oxlint/plugins": "1.93.0",
		"@rspack/core": "2.3.0",
		"@shadcn/lint": "0.2.3",
		"@storybook/react-vite": "10.6.5",
		"@swc-node/register": "1.12.1",
		"@swc/core": "1.16.21",
		"@swc/helpers": "0.5.23",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.1.2",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"jiti": "2.7.0",
		"jsdom": "30.1.3",
		"nx": "24.0.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"storybook": "10.6.5",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.156.0",
		"@tailwindcss/vite": "4.3.3"
	},
	"engines": {
		"node": "26.13.0",
		"pnpm": "12.16.1"
	}
}
