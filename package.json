{
	"name": "sketchi",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"affected": "nx affected",
		"build": "nx run-many -t build",
		"build-storybook": "nx run-many -t build-storybook",
		"cf-typegen:eval-harness": "nx cf-typegen eval-harness",
		"cf-typegen:all": "nx run-many -t cf-typegen",
		"deploy:excalidraw": "nx deploy excalidraw",
		"deploy:icons": "nx deploy icons",
		"chromatic": "nx chromatic native-conversion-storybook",
		"deploy:eval-harness": "nx deploy eval-harness",
		"deploy:playground": "nx deploy playground",
		"deploy:web": "nx deploy web",
		"dev": "nx run-many -t dev --parallel=5",
		"dev:excalidraw": "pnpm nx dev excalidraw",
		"dev:icons": "pnpm nx dev icons",
		"dev:eval-harness": "pnpm nx dev eval-harness",
		"dev:playground": "pnpm nx dev playground",
		"dev:web": "pnpm nx dev web",
		"eval:harness": "jiti tools/harness-eval.ts",
		"eval:studio-routing": "jiti tools/studio-routing-eval.ts",
		"check": "pnpm run lint && pnpm run format:check && pnpm run test:lint-rules",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "nx run-many -t build --projects=tag:scope:package --outputStyle=static-failures-only && oxlint",
		"preview": "nx run-many -t preview --parallel",
		"probe:generation-reliability": "jiti tools/generation-reliability-probe.ts",
		"r2sql:smoke": "JITI_TSCONFIG_PATHS=scripts/pipelines/tsconfig.json jiti scripts/pipelines/r2-catalog-smoke.ts",
		"r2sql:codemode:resources": "node scripts/pipelines/codemode-r2-catalog.mjs resources",
		"r2sql:codemode:verify-run": "node scripts/pipelines/codemode-r2-catalog.mjs verify-run",
		"test:lint-rules": "vitest run --config tools/vitest.config.mts tools/oxlint",
		"test:tools": "tsc -p tools/tsconfig.json --noEmit && vitest run --config tools/vitest.config.mts",
		"storybook": "nx storybook diagram-ui",
		"storybook:excalidraw": "nx storybook excalidraw",
		"storybook:icons": "nx storybook icons",
		"storybook:web": "nx storybook web",
		"test": "nx run-many -t test",
		"test:deploy-scripts": "tsc -p scripts/pipelines/tsconfig.json --noEmit && node --test scripts/lib/*.test.mjs scripts/lib/deploy/*.test.mjs scripts/pipelines/*.test.mjs && vitest run --config scripts/pipelines/vitest.config.mts",
		"test:wrangler-dry-runs": "node scripts/06-dry-run-worker-apps.mjs",
		"test:onboarding": "node --test scripts/lib/code-mode-onboarding.test.mjs",
		"toolchain:verify": "node scripts/verify-toolchain.mjs",
		"typecheck": "nx run-many -t typecheck",
		"typecheck:native": "nx run-many -t typecheck-native"
	},
	"dependencies": {
		"@cloudflare/codemode": "0.5.3",
