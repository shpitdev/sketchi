		"@standard-schema/spec": "1.1.0",
		"@tanstack/react-query": "5.104.1",
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-start": "1.168.60",
		"agents": "0.26.0",
		"effect": "4.0.1",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/plugin-proposal-decorators": "7.29.7",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@cloudflare/vite-plugin": "1.63.0",
		"@effect/platform-node": "4.0.1",
		"@effect/vitest": "4.0.1",
		"@nx/devkit": "23.2.1",
		"@nx/eslint-plugin": "23.2.1",
		"@nx/js": "23.2.1",
		"@nx/plugin": "23.2.1",
		"@nx/react": "23.2.1",
		"@nx/storybook": "23.2.1",
		"@nx/vite": "23.2.1",
		"@nx/vitest": "23.2.1",
		"@oxlint/plugins": "1.87.0",
		"@rspack/core": "2.2.8",
		"@storybook/addon-mcp": "10.6.1",
		"@storybook/addon-vitest": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@swc-node/register": "1.12.1",
		"@swc/cli": "0.8.1",
		"@swc/core": "1.16.13",
		"@swc/helpers": "0.5.23",
		"@tanstack/router-plugin": "1.168.42",
		"@testing-library/react": "16.3.3",
