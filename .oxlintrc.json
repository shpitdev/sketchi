// Sketchi's single lint gate: type-aware Oxlint over the whole repository.
// `pnpm run lint` builds package declarations first, because type-aware rules
// resolve workspace packages through their built `dist` types (as typecheck does).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "node",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "jsPlugins": [
    // Provides @nx/enforce-module-boundaries; ESLint itself is not installed.
    { "name": "@nx", "specifier": "@nx/eslint-plugin" },
    "./tools/oxlint/sketchi-plugin.ts"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
          }
        ],
        "patterns": [
          {
            "group": ["zod/**"],
            "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
          },
          {
            "group": ["effect/unstable/**"],
            "message": "Unstable Effect modules require a reviewed adapter under src/internal/effect-unstable-*.ts."
          }
        ]
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "react-hooks/rules-of-hooks": "error",
    // `import("…")` types bypass no-restricted-imports; mirror its policy.
    "sketchi/no-restricted-import-types": [
      "error",
      {
        "modules": [
          {
            "name": "zod",
            "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
          },
          {
            "name": "effect/unstable",
            "message": "Unstable Effect modules require a reviewed adapter under src/internal/effect-unstable-*.ts."
          }
        ]
      }
    ],
    "sketchi/no-react-effects": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        // node:test registers these promises with its own runner.
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": ["describe", "it", "suite", "test"],
            "package": "node:test"
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "unicorn/prefer-node-protocol": "error",
    "vitest/expect-expect": [
      "error",
      {
        // Curried @effect/vitest forms (it.layer, it.effect.each, it.live.runIf)
        // and property tests delegate assertions to helpers, so only the direct
        // test-block forms are checked for assertions.
        "additionalTestBlockFunctions": ["it.effect", "it.live"],
        "assertFunctionNames": [
          "assert",
          "assert.*",
          "expect",
          "expect.*",
          "expect*"
        ]
      }
    ],
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.effect.each",
          "it.effect.prop",
          "it.live",
          "it.live.runIf"
        ]
      }
    ],
    // Vitest accepts a custom failure message as the second argument.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    // Effect.fn and Effect.gen bodies are generators by API contract, even when
    // a particular body has nothing to yield.
    "eslint/require-yield": "off",
    // Spreading Schema.Class records into a constructor input is the idiomatic
    // way to derive an updated record; the constructor re-validates it.
    "typescript/no-misused-spread": "off",
    // Flags `[...map]` snapshots taken before mutating the map inside the loop,
    // and its autofix would remove them.
    "unicorn/no-useless-spread": "off",
    // Narrowing an Effect Exit or Result after asserting its tag is the
    // idiomatic way to inspect failures.
    "vitest/no-conditional-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    // `role="status"` live regions are the WAI-ARIA pattern; <output> is for
    // calculation results.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      // Vendored AI Elements registry components stay close to upstream so
      // registry updates apply cleanly. Their React idioms are upstream's.
      "files": ["apps/playground/src/components/ai-elements/**"],
      "rules": {
        "react/refs": "off",
        "react/static-components": "off",
        "sketchi/no-react-effects": "off",
        "typescript/no-misused-promises": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["apps/**", "packages/**", "tools/**"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            // Vite and Storybook configs consume these non-project workspace
            // inputs. Keep the exceptions exact so every project-to-project
            // import is still checked, including imports from config files.
            "allow": [
              "^\\.\\./\\.\\./scripts/lib/worker-apps\\.mjs$",
              "^(\\.\\./){2,4}scripts/lib/excalidraw-fonts\\.mjs$",
              "^\\.\\./\\.\\./tools/local-dev-ports$"
            ],
            "depConstraints": [
              {
                "sourceTag": "scope:package",
                "onlyDependOnLibsWithTags": ["scope:package"]
              },
              {
                "sourceTag": "scope:tool",
                "onlyDependOnLibsWithTags": ["scope:tool", "scope:package"]
              },
              {
                "sourceTag": "scope:app",
                "onlyDependOnLibsWithTags": ["scope:package"]
              },
              {
                "sourceTag": "scope:composition",
                "onlyDependOnLibsWithTags": ["scope:package", "scope:app"]
              },
              {
                "sourceTag": "type:runtime",
                "onlyDependOnLibsWithTags": [
                  "type:contract",
                  "type:persistence",
                  "type:runtime",
                  "type:ui"
                ]
              },
              {
                "sourceTag": "type:persistence",
                "onlyDependOnLibsWithTags": [
                  "type:contract",
                  "type:persistence",
                  "type:runtime"
                ]
              }
            ],
            "enforceBuildableLibDependency": true
          }
        ]
      }
    },
    {
      // Pure and framework-native projects keep Effect at its owning
      // orchestration boundary. tools/project-graph.test.ts keeps this list in
      // sync with the project classification.
      "files": [
        "apps/excalidraw/**",
        "apps/icons/**",
        "apps/native-conversion-storybook/**",
        "apps/web/**",
        "packages/diagram/core/**",
        "packages/diagram/excalidraw/**",
        "packages/diagram/renderer/**",
        "packages/diagram/ui/**",
        "packages/icons/catalog/**",
        "packages/svg-excalidraw/**",
        "tools/sketchi-generators/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              },
              {
                "name": "effect",
                "message": "This project is pure or framework-native; keep Effect at its owning orchestration boundary."
              }
            ],
            "patterns": [
              {
                "group": ["zod/**"],
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              },
              {
                "group": ["effect/**", "@effect/**"],
                "message": "This project is pure or framework-native; keep Effect at its owning orchestration boundary."
              }
            ]
          }
        ],
        "sketchi/no-restricted-import-types": [
          "error",
          {
            "modules": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              },
              {
                "name": "effect",
                "message": "This project is pure or framework-native; keep Effect at its owning orchestration boundary."
              },
              {
                "name": "@effect",
                "message": "This project is pure or framework-native; keep Effect at its owning orchestration boundary."
              }
            ]
          }
        ]
      }
    },
    {
      // Diagram-core's schema boundary files may use stable Effect Schema.
      "files": [
        "packages/diagram/core/src/intermediate.ts",
        "packages/diagram/core/src/types/flowchart.ts",
        "packages/diagram/core/src/types/flowchart.test.ts",
        "packages/diagram/core/src/types/mindmap.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              }
            ],
            "patterns": [
              {
                "group": ["zod/**"],
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              },
              {
                "group": ["effect/unstable/**"],
                "message": "Unstable Effect modules require a reviewed adapter under src/internal/effect-unstable-*.ts."
              }
            ]
          }
        ],
        "sketchi/no-restricted-import-types": [
          "error",
          {
            "modules": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              },
              {
                "name": "effect/unstable",
                "message": "Unstable Effect modules require a reviewed adapter under src/internal/effect-unstable-*.ts."
              }
            ]
          }
        ]
      }
    },
    {
      // Reviewed adapters are the only place unstable Effect modules may enter.
      "files": [
        "apps/**/src/internal/effect-unstable-*.ts",
        "packages/**/src/internal/effect-unstable-*.ts",
        "tools/**/src/internal/effect-unstable-*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              }
            ],
            "patterns": [
              {
                "group": ["zod/**"],
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              }
            ]
          }
        ],
        "sketchi/no-restricted-import-types": [
          "error",
          {
            "modules": [
              {
                "name": "zod",
                "message": "Sketchi models data with Effect Schema; decode with Schema instead of Zod."
              }
            ]
          }
        ]
      }
    }
  ],
  // Generated or non-source output only; every authored file is linted.
  "ignorePatterns": [
    ".memory/**",
    ".nx/**",
    "**/.output/**",
    "**/.wrangler/**",
    "**/cloudflare-workers.d.ts",
    "**/dist/**",
    "**/routeTree.gen.ts",
    "coverage/**",
    "storybook-static/**"
  ]
}
