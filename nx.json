{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": [
			"default",
			"!{projectRoot}/**/*.test.ts",
			"!{projectRoot}/**/*.test.tsx",
			"!{projectRoot}/**/tests/**/*",
			"!{projectRoot}/**/*.stories.tsx",
			"!{projectRoot}/.storybook/**/*",
			"!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
			"!{projectRoot}/tsconfig.spec.json"
		],
		"sharedGlobals": [
			"{workspaceRoot}/.oxlintrc.json",
			"{workspaceRoot}/nx.json",
			"{workspaceRoot}/tsconfig.base.json",
			"{workspaceRoot}/package.json",
			"{workspaceRoot}/pnpm-lock.yaml",
			"{workspaceRoot}/pnpm-workspace.yaml",
			"{workspaceRoot}/mise.toml",
			{
				"runtime": "node --version"
			},
			{
				"runtime": "node -p \"process.platform + '-' + process.arch\""
			},
			{
				"env": "CI"
			},
			{
				"env": "NODE_ENV"
			},
			{
				"env": "NODE_OPTIONS"
			},
			{
				"env": "PORT"
			}
		],
		"testEnvironment": [
			{
				"env": "ROUTING_FUZZ"
			},
			{
				"env": "ER_FUZZ"
			},
			{
				"env": "ER_FUZZ_SEED"
			},
			{
				"env": "CLASS_FUZZ"
			},
			{
				"env": "CLASS_FUZZ_SEED"
			},
			{
				"env": "SEQUENCE_FUZZ"
			},
			{
				"env": "ORG_CHART_FUZZ"
			},
			{
				"env": "JOURNEY_FUZZ"
			},
			{
				"env": "SANKEY_FUZZ"
			},
			{
				"env": "SANKEY_FUZZ_DUMP"
			},
			{
				"env": "WIREFRAME_FUZZ"
			},
			{
				"env": "QUADRANT_FUZZ"
			},
			{
				"env": "CHART_FUZZ_SEEDS"
			},
			{
				"env": "GANTT_FUZZ_SEEDS"
			},
			{
				"env": "MINDMAP_FUZZ_SEEDS"
			},
			{
				"env": "VENN_FUZZ"
			},
			{
				"env": "PRINT_ROUTING"
			},
			{
				"env": "PRINT_CROSSINGS"
			},
			{
				"env": "TZ"
			},
			{
				"env": "LANG"
			},
			{
				"env": "LC_ALL"
			},
			{
				"env": "TERM"
			},
			{
				"env": "NO_COLOR"
			},
			{
				"env": "FORCE_COLOR"
			},
			{
				"env": "COLORFGBG"
			}
		],
		"diagramTestShared": [
			"sharedGlobals",
			"{workspaceRoot}/packages/diagrams/vitest*.ts",
			"{workspaceRoot}/packages/diagrams/tsconfig*.json",
			"{workspaceRoot}/packages/diagrams/project.json",
			"{workspaceRoot}/packages/diagrams/test/**/*",
			"{workspaceRoot}/packages/diagrams/src/*.ts",
			"{workspaceRoot}/packages/diagrams/src/build/**/*",
			"{workspaceRoot}/packages/diagrams/src/canvas/**/*",
			"{workspaceRoot}/packages/diagrams/src/generate/**/*"
		],
		"workspaceFiles": ["{workspaceRoot}/**/*", "sharedGlobals"]
	},
	"targetDefaults": {
		"build": {
			"inputs": ["production", "^production"],
			"dependsOn": ["^build"],
			"cache": true
		},
		"test": {
			"inputs": ["default", "^production", "testEnvironment"],
			"dependsOn": ["^build"],
			"cache": true
		},
		"typecheck": {
			"inputs": ["default", "^production"],
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": []
		}
	},
	"release": {
		"projects": ["sketchi-cli"],
		"changelog": {
			"workspaceChangelog": false
		},
		"releaseTag": {
			"pattern": "cli-v{version}"
		}
	},
	"analytics": false,
	"affected": {
		"legacy": false
	},
	"sync": {
		"globalGenerators": ["@nx/js:typescript-sync"]
	}
}
