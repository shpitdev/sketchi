              "apps/studio/src/routes/diagrams/$diagramId.tsx",
              "apps/studio/src/routes/diagrams_/$diagramId/edit.tsx",
              "apps/studio/src/routes/projects.tsx",
              "apps/studio/src/routes/projects_/$projectId.tsx",
              "apps/studio/src/features/projects/host.server.ts",
              "apps/icons/src/features/community/atoms.ts",
              "apps/icons/src/routes/index.tsx",
              "apps/icons/src/routes/packs/$id.tsx",
              "apps/icons/src/routes/__root.tsx",
              "apps/icons/src/features/community/community-page.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "error",
                "globalJson": "error",
                "preferEffectArray": "error",
                "preferEffectRecord": "error",
                "preferEffectString": "error"
              }
            }
          },
          {
            "include": [
