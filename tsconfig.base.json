              "apps/editor/src/routes/__root.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "error",
                "globalJson": "error",
                "preferEffectArray": "error",
                "preferEffectRecord": "error",
                "preferEffectString": "error"
              }
            }
          },
