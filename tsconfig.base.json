{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "useDefineForClassFields": true,
    "paths": {
      "@sketchi/generators": ["./tools/sketchi-generators/src/index.ts"],
      "@sketchi/studio-projects/client": ["./packages/studio/projects/src/client.ts"],
      "@sketchi/studio-projects/server": ["./packages/studio/projects/src/server.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "ignoreEffectSuggestionsInTscExitCode": true,
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "anyUnknownInErrorContext": "error",
          "apiStabilityLeak": "off",
          "asyncFunction": "warning",
          "classSelfMismatch": "error",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "duplicatePackage": "error",
          "effectFnImplicitAny": "error",
          "errorPayloadShadowsName": "error",
          "experimentalApiUsage": "off",
          "extendsNativeError": "warning",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "genericEffectServices": "error",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalJson": "warning",
          "globalJsonInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "missingReturnYieldStar": "error",
          "missingStarInYieldEffectGen": "error",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          "nonObjectEffectServiceType": "error",
          "obsoleteMatchImport": "error",
          "obsoleteSchemaImport": "error",
          "outdatedApi": "error",
          "overriddenSchemaConstructor": "error",
          "preferEffectArray": "warning",
          "preferEffectRecord": "warning",
          "preferEffectString": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          "promiseInEffectSuccess": "error",
          "runEffectInsideEffect": "warning",
          "schemaClassMissingBrand": "error",
          "schemaClassObjectLiteral": "error",
          "schemaLiteralNonFinite": "error",
          "schemaOpaqueInstanceMember": "error",
          "schemaSync": "warning",
          "schemaSyncInEffect": "warning",
          "strictEffectProvide": "warning",
          "unsafeEffectTypeAssertion": "error",
          "unstableApiUsage": "off"
        }
      }
    ]
  }
}
