              "apps/icons/src/features/mcp/toolkit.server.ts",
              "packages/cloudflare/src/mcp-content.ts",
              "packages/cloudflare/src/mcp-http.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "error",
                "globalJson": "error",
                "preferEffectArray": "error",
                "preferEffectRecord": "error",
                "preferEffectString": "error"
              }
            }
          },
          {
            "include": [
              "packages/icons/draw/src/lib/author-model.ts",
