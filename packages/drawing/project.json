{
	"name": "drawing",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/drawing/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:drawing"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/drawing"],
			"options": {
				"command": "vitest run --config packages/drawing/vitest.config.ts"
			},
			"inputs": [
				"default",
				"{workspaceRoot}/tools/drawing-tests/**/*",
				"{workspaceRoot}/packages/diagrams/src/**/*"
			]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"routing-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ROUTING_FUZZ=full vitest run --config packages/drawing/vitest.config.ts tools/drawing-tests/routing-fuzz.test.ts"
			},
			"inputs": [
				"default",
				"{workspaceRoot}/tools/drawing-tests/**/*",
				"{workspaceRoot}/packages/diagrams/src/**/*"
			]
		},
		"er-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ER_FUZZ=full vitest run --config packages/drawing/vitest.config.ts tools/drawing-tests/er-fuzz.test.ts"
			},
			"inputs": [
