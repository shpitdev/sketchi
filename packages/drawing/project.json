{
	"name": "drawing",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/drawing/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:drawing"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/drawing"],
			"options": {
				"command": "vitest run --config packages/drawing/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
