{
	"name": "drawing",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/drawing/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:drawing"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/drawing"],
			"inputs": [
				"default",
				"^production",
				"testEnvironment",
				"{workspaceRoot}/packages/icons/catalog/svg/**/*.svg"
			],
			"options": {
				"commands": [
					"vitest run --config packages/drawing/vitest.config.ts",
					"vitest run --config packages/drawing/vitest.svg.config.ts"
				],
				"parallel": false
			}
		},
		"corpus-renderer": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/.memory/svg-native-corpus"],
			"inputs": ["default", "^production", "{workspaceRoot}/packages/icons/catalog/svg/**/*.svg"],
			"dependsOn": ["^build"],
			"options": {
				"command": "SVG_NATIVE_CORPUS_REPORT=.memory/svg-native-corpus/native-renderer.json vitest run --config packages/drawing/vitest.corpus.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/drawing/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
