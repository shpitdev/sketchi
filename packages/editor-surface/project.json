{
	"name": "editor-surface",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/editor-surface/src",
	"projectType": "library",
	"tags": ["scope:package", "type:ui"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"commands": [
					"vite build --config packages/editor-surface/vite.config.ts",
					"effect-tsgo tsc@7.0.2 -p packages/editor-surface/tsconfig.lib.json"
				],
				"parallel": false
			}
		},
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/editor-surface"],
			"options": {
				"output-dir": "../../storybook-static/editor-surface"
			}
		},
		"chromatic": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-storybook"],
			"options": {
				"command": "chromatic --storybook-build-dir storybook-static/editor-surface --storybook-config-dir packages/editor-surface/.storybook --storybook-base-dir packages/editor-surface"
			}
		},
		"static-storybook": {
			"options": {
				"staticFilePath": "storybook-static/editor-surface"
			}
		},
		"storybook": {
			"options": {
				"port": 6006
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/editor-surface"],
			"options": {
				"command": "vitest run --config packages/editor-surface/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/editor-surface/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/editor-surface/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"check-storybook": {
			"executor": "nx:noop",
			"inputs": ["default", "^default", "{workspaceRoot}/tools/ops/src/vite/excalidraw-fonts.ts"],
			"dependsOn": ["build-storybook"]
		}
	}
}
