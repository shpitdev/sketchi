{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "diagram-studio-ui",
  "projectType": "library",
  "sourceRoot": "packages/diagram-studio-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "vite build --config packages/diagram-studio-ui/vite.config.ts",
          "tsc -b packages/diagram-studio-ui/tsconfig.lib.json"
        ],
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build -c .storybook -o ../../dist/storybook/diagram-studio-ui",
        "cwd": "packages/diagram-studio-ui"
      },
      "outputs": ["{workspaceRoot}/dist/storybook/diagram-studio-ui"]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -c .storybook -p 6006",
        "cwd": "packages/diagram-studio-ui"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "node tools/storybook/verify-diagram-studio-stories.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "packages/diagram-studio-ui"
      },
      "outputs": ["{workspaceRoot}/coverage/packages/diagram-studio-ui"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b packages/diagram-studio-ui/tsconfig.json"
      }
    },
    "typecheck-tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo -b packages/diagram-studio-ui/tsconfig.json"
      }
    }
  },
  "implicitDependencies": ["diagram-core", "diagram-renderer"],
  "tags": ["scope:diagram", "type:ui"]
}
