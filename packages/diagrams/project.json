{
	"name": "diagrams",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagrams/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagrams"],
			"options": {
				"command": "vitest run --config packages/diagrams/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"mindmap-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "MINDMAP_FUZZ_SEEDS=2000 vitest run --config packages/diagrams/vitest.config.ts packages/diagrams/src/families/mindmap/mindmap-fuzz.test.ts"
			}
		},
		"gantt-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "GANTT_FUZZ_SEEDS=300 vitest run --config packages/diagrams/vitest.config.ts packages/diagrams/src/families/gantt/render.test.ts -t \"seeded fuzz\""
			}
		},
		"chart-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "CHART_FUZZ_SEEDS=300 vitest run --config packages/diagrams/vitest.config.ts packages/diagrams/src/families/chart/render.test.ts -t \"seeded fuzz\""
			}
		}
	}
}
