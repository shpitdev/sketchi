{
	"name": "diagrams",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagrams/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:diagrams"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagrams"],
			"options": {
				"command": "vitest run --config packages/diagrams/vitest.config.ts"
			},
			"inputs": [
				"default",
				"^production",
				"testEnvironment",
				"{workspaceRoot}/packages/editor-surface/src/theme.css"
			]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/diagrams/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"mindmap-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "MINDMAP_FUZZ_SEEDS=2000 vitest run --config packages/diagrams/vitest.family.config.ts packages/diagrams/src/families/mindmap/tests/mindmap-fuzz.test.ts"
			},
			"inputs": [
				"diagramTestShared",
				"testEnvironment",
				"^production",
				"{projectRoot}/src/families/mindmap/**/*",
				"{projectRoot}/src/graph/**/*"
			],
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": []
		},
		"gantt-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "GANTT_FUZZ_SEEDS=300 vitest run --config packages/diagrams/vitest.family.config.ts packages/diagrams/src/families/gantt/tests/gantt-fuzz.test.ts -t \"seeded fuzz\""
			},
			"inputs": [
				"diagramTestShared",
				"testEnvironment",
				"^production",
				"{projectRoot}/src/families/gantt/**/*",
				"{projectRoot}/src/graph/**/*",
