{
  "name": "@sketchi/icon-catalog",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./node-logo-svgs": {
      "types": "./dist/node-logo-svgs.d.ts",
      "default": "./dist/node-logo-svgs.json"
    },
    "./node-logos/*": "./dist/node-logos/*",
    "./package.json": "./package.json"
  }
}
