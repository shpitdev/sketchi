{
	"name": "@sketchi/icon-catalog",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"default": "./dist/catalog.js"
		},
		"./concepts": {
			"types": "./dist/concepts.d.ts",
			"default": "./dist/concepts.js"
		},
		"./generic-prompts": {
			"types": "./dist/generic-prompts.d.ts",
			"default": "./dist/generic-prompts.js"
		},
		"./node-logo-svgs": {
			"types": "./dist/node-logo-svgs.d.ts",
			"default": "./dist/node-logo-svgs.json"
		},
		"./native-icons": {
			"types": "./dist/native-icons.d.ts",
			"default": "./dist/native-icons.json"
		},
		"./look-alikes": {
			"types": "./dist/look-alikes.d.ts",
			"default": "./dist/look-alikes.js"
		},
		"./node-logos/*": "./dist/node-logos/*",
		"./svg/*": "./svg/*",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"fast-xml-parser": "5.11.2"
	},
	"devDependencies": {
		"@resvg/resvg-wasm": "2.6.2",
		"lucide-static": "1.65.0",
		"svg-pathdata": "9.0.0",
		"wordlist-english": "1.2.1"
	}
}
