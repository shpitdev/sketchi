{
	"name": "icon-catalog",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/icons/catalog/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/icons/catalog/tsconfig.lib.json && jiti packages/icons/catalog/scripts/build-node-logos.ts && jiti packages/icons/catalog/scripts/build-native-icons.ts"
			}
		},
		"generate-catalog": {
			"executor": "nx:run-commands",
			"inputs": [
				"{projectRoot}/pipeline-output/review/review-data.json",
				"{projectRoot}/svg/**/*",
				"{projectRoot}/src/color-mode.ts",
				"{projectRoot}/src/icon-color-render.ts"
			],
			"outputs": ["{projectRoot}/src/generated/icon-catalog.json"],
			"options": {
				"command": "jiti packages/icons/catalog/scripts/generate-catalog.ts"
			}
		},
		"generate-look-alikes": {
			"executor": "nx:run-commands",
			"inputs": [
				"{projectRoot}/svg/**/*",
				"{projectRoot}/src/generated/icon-catalog.json",
				"{projectRoot}/src/mark-features.ts",
				"{projectRoot}/src/svg-input.ts"
			],
			"outputs": ["{projectRoot}/src/generated/look-alikes.json"],
			"options": {
				"command": "jiti packages/icons/catalog/scripts/generate-look-alikes.ts"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/icons/catalog"],
			"options": {
				"command": "vitest run --config packages/icons/catalog/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/icons/catalog/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/icons/catalog/tsconfig.json --noEmit"
			}
		}
	}
}
