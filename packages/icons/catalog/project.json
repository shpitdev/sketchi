{
	"name": "icon-catalog",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/icons/catalog/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:icons"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/icons/catalog/tsconfig.lib.json && jiti packages/icons/catalog/scripts/build-node-logos.ts && jiti packages/icons/catalog/scripts/build-native-icons.ts"
			}
		},
		"generate-catalog": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "jiti packages/icons/catalog/scripts/generate-catalog.ts"
			}
		},
		"generate-look-alikes": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "jiti packages/icons/catalog/scripts/generate-look-alikes.ts"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --config packages/icons/catalog/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/icons/catalog/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/icons/catalog/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
