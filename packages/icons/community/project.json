{
	"name": "community-icons",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/icons/community/src",
	"projectType": "library",
	"tags": ["scope:package", "type:persistence", "domain:icons"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/icons/community/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/icons/community"],
			"options": {
				"command": "vitest run --config packages/icons/community/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/icons/community/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/icons/community/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
