{
	"name": "cloudflare",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/cloudflare/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime", "domain:cloudflare"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/cloudflare/tsconfig.lib.json"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/cloudflare/tsconfig.lib.json --noEmit"
			}
		}
	}
}
