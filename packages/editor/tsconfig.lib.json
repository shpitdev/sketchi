{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.tsx", "src/**/*.stories.tsx", "src/**/*.fixtures.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../drawing/tsconfig.lib.json"
    },
    {
      "path": "../diagrams/tsconfig.lib.json"
    },
    {
      "path": "../diagram/renderer/tsconfig.lib.json"
    },
    {
      "path": "../diagram/core/tsconfig.lib.json"
    },
    {
      "path": "../icons/catalog/tsconfig.lib.json"
    },
    {
      "path": "../diagram/scenarios/tsconfig.lib.json"
    }
  ]
}
