{
	"name": "social-card",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/social-card/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/social-card/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/social-card"],
			"options": {
				"command": "vitest run --config packages/social-card/vitest.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/social-card/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/social-card/tsconfig.json --noEmit"
			}
		}
	}
}
