{
	"name": "diagram-renderer",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/renderer/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/diagram/renderer/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/renderer"],
			"options": {
				"command": "vitest run --config packages/diagram/renderer/vitest.config.ts"
			}
		},
		"gantt-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "GANTT_FUZZ_SEEDS=300 vitest run --config packages/diagram/renderer/vitest.config.ts packages/diagram/renderer/src/diagram-types/gantt.test.ts -t \"seeded fuzz\""
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/diagram/renderer/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/diagram/renderer/tsconfig.json --noEmit"
			}
		}
	}
}
