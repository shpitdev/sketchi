{
	"name": "diagram-generation",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/generation/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/diagram/generation/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/generation"],
			"options": {
				"command": "vitest run --config packages/diagram/generation/vitest.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/diagram/generation/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/diagram/generation/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
