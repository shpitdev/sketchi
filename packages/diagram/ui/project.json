{
	"name": "diagram-ui",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/ui/src",
	"projectType": "library",
	"tags": ["scope:package", "type:ui"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"commands": [
					"vite build --config packages/diagram/ui/vite.config.ts",
					"tsc6 -p packages/diagram/ui/tsconfig.lib.json"
				],
				"parallel": false
			}
		},
		"build-storybook": {
			"outputs": ["{workspaceRoot}/storybook-static/diagram-ui"],
			"options": {
				"output-dir": "../../../storybook-static/diagram-ui"
			}
		},
		"chromatic": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-storybook"],
			"options": {
				"command": "chromatic --storybook-build-dir storybook-static/diagram-ui --storybook-config-dir packages/diagram/ui/.storybook --storybook-base-dir packages/diagram/ui"
			}
		},
		"storybook": {
			"options": {
				"port": 6006
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/ui"],
			"options": {
				"command": "vitest run --config packages/diagram/ui/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/diagram/ui/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/diagram/ui/tsconfig.json --noEmit"
			}
		}
	}
}
