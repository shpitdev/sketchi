{
	"name": "diagram-core",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/core/src",
	"projectType": "library",
	"tags": ["scope:package", "type:contract"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/diagram/core/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/core"],
			"options": {
				"command": "vitest run --config packages/diagram/core/vitest.config.ts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"tsc6 -p packages/diagram/core/tsconfig.spec.json --noEmit",
					"tsc6 -p packages/diagram/core/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/diagram/core/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/diagram/core/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
