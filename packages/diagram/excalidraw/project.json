{
	"name": "diagram-excalidraw",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/excalidraw/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/diagram/excalidraw/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/excalidraw"],
			"options": {
				"command": "vitest run --config packages/diagram/excalidraw/vitest.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/diagram/excalidraw/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/diagram/excalidraw/tsconfig.json --noEmit"
			}
		},
		"routing-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ROUTING_FUZZ=full vitest run --config packages/diagram/excalidraw/vitest.config.mts packages/diagram/excalidraw/src/lib/routing-fuzz.test.ts"
			}
		},
		"er-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ER_FUZZ=full vitest run --config packages/diagram/excalidraw/vitest.config.mts packages/diagram/excalidraw/src/lib/er-fuzz.test.ts"
			}
		},
		"class-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "CLASS_FUZZ=full vitest run --config packages/diagram/excalidraw/vitest.config.mts packages/diagram/excalidraw/src/lib/class-fuzz.test.ts"
			}
		},
		"sequence-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "SEQUENCE_FUZZ=full vitest run --config packages/diagram/excalidraw/vitest.config.mts packages/diagram/excalidraw/src/lib/sequence-fuzz.test.ts"
			}
		},
		"org-chart-fuzz": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ORG_CHART_FUZZ=full vitest run --config packages/diagram/excalidraw/vitest.config.mts packages/diagram/excalidraw/src/lib/org-chart-fuzz.test.ts"
			}
		}
	}
}
