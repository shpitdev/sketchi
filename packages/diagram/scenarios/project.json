{
	"name": "diagram-scenarios",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/diagram/scenarios/src",
	"projectType": "library",
	"tags": ["scope:package", "type:eval"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/diagram/scenarios/tsconfig.lib.json"
			}
		},
		"scenario": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "node packages/diagram/scenarios/dist/cli.js"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/diagram/scenarios"],
			"options": {
				"command": "vitest run --config packages/diagram/scenarios/vitest.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/diagram/scenarios/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/diagram/scenarios/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"check-scenario": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["production", "^production"],
			"outputs": [],
			"dependsOn": ["build"],
			"options": {
				"commands": [
					"node packages/diagram/scenarios/dist/cli.js --list",
					"node packages/diagram/scenarios/dist/cli.js --scenario sketchi-onboarding-decision-flow --fixture"
				],
				"parallel": false
			}
		}
	}
}
