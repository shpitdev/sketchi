{
	"name": "ui",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/ui/src",
	"projectType": "library",
	"tags": ["scope:package", "type:ui"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/ui/tsconfig.lib.json"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc6 -p packages/ui/tsconfig.json --noEmit"
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p packages/ui/tsconfig.json --noEmit"
			}
		}
	}
}
