{
	"name": "ui",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/ui/src",
	"projectType": "library",
	"tags": ["scope:package", "type:ui"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc6 -p packages/ui/tsconfig.lib.json"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"tsc6 -p packages/ui/tsconfig.spec.json --noEmit",
					"tsc6 -p packages/ui/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"typecheck-native": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/ui/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/ui/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node --test packages/ui/wordmark/write.test.mjs"
			}
		},
		"wordmark": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node packages/ui/wordmark/write.mjs"
			}
		}
	}
}
