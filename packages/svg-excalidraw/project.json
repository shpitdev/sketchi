{
  "name": "svg-excalidraw",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/svg-excalidraw/src",
  "projectType": "library",
  "tags": ["scope:package", "type:runtime"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p packages/svg-excalidraw/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/svg-excalidraw"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/**/*.svg"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config packages/svg-excalidraw/vitest.config.mts"
          },
          {
            "command": "vitest run --config packages/svg-excalidraw/vitest.browser.config.mts"
          }
        ],
        "parallel": false
      }
    },
    "corpus-renderer": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/.memory/svg-native-corpus"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/**/*.svg"
      ],
      "options": {
        "command": "SVG_NATIVE_CORPUS_REPORT=.memory/svg-native-corpus/native-renderer.json vitest run --config packages/svg-excalidraw/vitest.corpus.config.mts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/svg-excalidraw/tsconfig.json --noEmit"
      }
    },
    "typecheck-tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo -p packages/svg-excalidraw/tsconfig.json --noEmit"
      }
    }
  }
}
