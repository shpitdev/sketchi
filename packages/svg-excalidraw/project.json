{
  "name": "svg-excalidraw",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/svg-excalidraw/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p packages/svg-excalidraw/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/svg-excalidraw"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/ai-model-providers/ai21labsai.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/ai-infrastructure/vllm.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/programming-languages/kotlin.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/gcp-legacy/cloud-router.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/ai-ecosystem/jimeng.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/gcp-legacy/connectivity-test.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/operating-systems/windows11.svg",
        "{workspaceRoot}/apps/icons/public/output/upload-ready/svg/operating-systems/linux.svg"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config packages/svg-excalidraw/vitest.config.mts"
          },
          {
            "command": "vitest run --config packages/svg-excalidraw/vitest.browser.config.mts"
          }
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/svg-excalidraw/tsconfig.json --noEmit"
      }
    },
    "typecheck-tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo -p packages/svg-excalidraw/tsconfig.json --noEmit"
      }
    }
  }
}
