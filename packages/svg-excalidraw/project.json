{
	"name": "svg-excalidraw",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/svg-excalidraw/src",
	"projectType": "library",
	"tags": ["scope:package", "type:runtime"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "effect-tsgo tsc@7.0.2 -p packages/svg-excalidraw/tsconfig.lib.json"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/coverage/packages/svg-excalidraw"],
			"inputs": ["default", "^production", "{workspaceRoot}/packages/icons/catalog/svg/**/*.svg"],
			"options": {
				"command": "vitest run --config packages/svg-excalidraw/vitest.config.mts"
			}
		},
		"corpus-renderer": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/.memory/svg-native-corpus"],
			"inputs": ["default", "^production", "{workspaceRoot}/packages/icons/catalog/svg/**/*.svg"],
			"dependsOn": ["^build"],
			"options": {
				"command": "SVG_NATIVE_CORPUS_REPORT=.memory/svg-native-corpus/native-renderer.json vitest run --config packages/svg-excalidraw/vitest.corpus.config.mts"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"effect-tsgo tsc@7.0.2 -p packages/svg-excalidraw/tsconfig.spec.json --noEmit",
					"effect-tsgo tsc@7.0.2 -p packages/svg-excalidraw/tsconfig.lib.json --noEmit"
				],
				"parallel": false
			}
		}
	}
}
