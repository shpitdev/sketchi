{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"],
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "dist/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts",
    "vitest.browser.config.mts",
    "src/**/*.test.ts"
  ]
}
